{
  "name": "onuw",
  "version": "1.0.0",
  "private": true,
  "description": "One Night Ultimate Werewolf — real-time multiplayer web app",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "build": "npm run build --workspace @onuw/shared && npm run build --workspace @onuw/server && npm run build --workspace @onuw/client",
    "start": "node server/dist/index.js",
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace @onuw/server",
    "dev:client": "npm run dev --workspace @onuw/client",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
